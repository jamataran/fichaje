<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext" xmlns:pro="http://www.liquibase.org/xml/ns/pro" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd http://www.liquibase.org/xml/ns/pro http://www.liquibase.org/xml/ns/pro/liquibase-pro-4.1.xsd http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">
    <changeSet author="Daviid" id="20260323-sede-1">
        <createTable tableName="sede">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="empresa_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="nombre" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="direccion" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="codigo_postal" type="VARCHAR(10)">
                <constraints nullable="true"/>
            </column>
            <column name="localidad" type="VARCHAR(100)">
                <constraints nullable="true"/>
            </column>
            <column name="provincia" type="VARCHAR(100)">
                <constraints nullable="true"/>
            </column>
            <column name="pais" type="VARCHAR(100)" defaultValue="España">
                <constraints nullable="true"/>
            </column>
            <column name="ubicacion" type="POINT">
                <constraints nullable="true"/>
            </column>
            <column name="activa" type="TINYINT" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="sede"/>
        </rollback>
    </changeSet>

    <changeSet author="Daviid" id="20260323-sede-2">
        <addForeignKeyConstraint
                baseTableName="sede"
                baseColumnNames="empresa_id"
                constraintName="fk_sede_empresa"
                referencedTableName="empresa"
                referencedColumnNames="id"/>
        <rollback>
            <dropForeignKeyConstraint baseTableName="sede" constraintName="fk_sede_empresa"/>
        </rollback>
    </changeSet>

    <changeSet author="Daviid" id="20260323-sede-3">
        <addUniqueConstraint
                tableName="sede"
                columnNames="empresa_id, nombre"
                constraintName="uk_sede_empresa_nombre"/>
        <rollback>
            <dropUniqueConstraint tableName="sede" constraintName="uk_sede_empresa_nombre"/>
        </rollback>
    </changeSet>
</databaseChangeLog>