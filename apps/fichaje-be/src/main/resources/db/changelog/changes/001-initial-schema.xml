    <!-- CAMBIO 1: ENGINE=InnoDB en todas las tablas via <modifySql>.
         Spring Boot generaba MyISAM (no soporta FK ni transacciones).
         CAMBIO 2: BIT(1) uniforme en todas las columnas booleanas.
         Spring Boot usaba tinyint(1) en calendarios.active, permisos.aprobado y vacaciones.aprobado. -->

    <changeSet author="Daviid (generated)" id="1771931772806-1">
        <createTable tableName="api_keys">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="active" type="BIT(1)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="description" type="VARCHAR(255)"/>
            <column name="expires_at" type="datetime"/>
            <column name="key_hash" type="VARCHAR(64)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="last_used_at" type="datetime"/>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="usuario_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <!-- CAMBIO 1: InnoDB en lugar de MyISAM -->
        <modifySql dbms="mysql">
            <append value=" ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci"/>
        </modifySql>
    </changeSet>

