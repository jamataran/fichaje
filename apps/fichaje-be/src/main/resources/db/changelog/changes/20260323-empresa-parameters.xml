<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext" xmlns:pro="http://www.liquibase.org/xml/ns/pro" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd http://www.liquibase.org/xml/ns/pro http://www.liquibase.org/xml/ns/pro/liquibase-pro-4.1.xsd http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">
    <changeSet author="Daviid" id="20260323-empresa-parametros-1">
        <createTable tableName="empresa_parametros">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="empresa_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="clave" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="valor" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="empresa_parametros"/>
        </rollback>
    </changeSet>

    <changeSet author="Daviid" id="20260323-empresa-parametros-2">
        <addForeignKeyConstraint
                baseTableName="empresa_parametros"
                baseColumnNames="empresa_id"
                constraintName="fk_empresa_parametros_empresa"
                referencedTableName="empresa"
                referencedColumnNames="id"/>
        <rollback>
            <dropForeignKeyConstraint baseTableName="empresa_parametros" constraintName="fk_empresa_parametros_empresa"/>
        </rollback>
    </changeSet>

    <changeSet author="Daviid" id="20260323-empresa-parametros-3">
        <addUniqueConstraint
                tableName="empresa_parametros"
                columnNames="empresa_id, clave"
                constraintName="uk_empresa_parametros_empresa_clave"/>
        <rollback>
            <dropUniqueConstraint tableName="empresa_parametros" constraintName="uk_empresa_parametros_empresa_clave"/>
        </rollback>
    </changeSet>
</databaseChangeLog>