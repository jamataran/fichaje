<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext" xmlns:pro="http://www.liquibase.org/xml/ns/pro" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd http://www.liquibase.org/xml/ns/pro http://www.liquibase.org/xml/ns/pro/liquibase-pro-4.1.xsd http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">
    <changeSet author="Daviid" id="20260323-sede-parametros-1">
        <createTable tableName="sede_parametros">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="sede_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="clave" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="valor" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="sede_parametros"/>
        </rollback>
    </changeSet>

    <changeSet author="Daviid" id="20260323-sede-parametros-2">
        <addForeignKeyConstraint
                baseTableName="sede_parametros"
                baseColumnNames="sede_id"
                constraintName="fk_sede_parametros_sede"
                referencedTableName="sede"
                referencedColumnNames="id"/>
        <rollback>
            <dropForeignKeyConstraint baseTableName="sede_parametros" constraintName="fk_sede_parametros_sede"/>
        </rollback>
    </changeSet>

    <changeSet author="Daviid" id="20260323-sede-parametros-3">
        <addUniqueConstraint
                tableName="sede_parametros"
                columnNames="sede_id, clave"
                constraintName="uk_sede_parametros_sede_clave"/>
        <rollback>
            <dropUniqueConstraint tableName="sede_parametros" constraintName="uk_sede_parametros_sede_clave"/>
        </rollback>
    </changeSet>
</databaseChangeLog>