<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext" xmlns:pro="http://www.liquibase.org/xml/ns/pro" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd http://www.liquibase.org/xml/ns/pro http://www.liquibase.org/xml/ns/pro/liquibase-pro-4.1.xsd http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">
    <changeSet author="Daviid" id="20260325-sede-refactor-1">
        <addColumn tableName="sede">
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="telefono" type="VARCHAR(20)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
        <rollback>
            <dropColumn tableName="sede">
                <column name="email"/>
                <column name="telefono"/>
            </dropColumn>
        </rollback>
    </changeSet>

    <changeSet author="Daviid" id="20260325-sede-refactor-2">
        <addNotNullConstraint tableName="sede" columnName="direccion" columnDataType="VARCHAR(255)" defaultNullValue=""/>
        <addNotNullConstraint tableName="sede" columnName="codigo_postal" columnDataType="VARCHAR(10)" defaultNullValue=""/>
        <addNotNullConstraint tableName="sede" columnName="localidad" columnDataType="VARCHAR(100)" defaultNullValue=""/>
        <addNotNullConstraint tableName="sede" columnName="provincia" columnDataType="VARCHAR(100)" defaultNullValue=""/>
        <addNotNullConstraint tableName="sede" columnName="pais" columnDataType="VARCHAR(100)" defaultNullValue="España"/>
        <rollback>
            <dropNotNullConstraint tableName="sede" columnName="direccion" columnDataType="VARCHAR(255)"/>
            <dropNotNullConstraint tableName="sede" columnName="codigo_postal" columnDataType="VARCHAR(10)"/>
            <dropNotNullConstraint tableName="sede" columnName="localidad" columnDataType="VARCHAR(100)"/>
            <dropNotNullConstraint tableName="sede" columnName="provincia" columnDataType="VARCHAR(100)"/>
            <dropNotNullConstraint tableName="sede" columnName="pais" columnDataType="VARCHAR(100)"/>
        </rollback>
    </changeSet>
</databaseChangeLog>