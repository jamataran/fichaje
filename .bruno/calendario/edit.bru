      "minutosMasEntrada": 10,
      "minutosMenosEntrada": 5,
      "dias": [
        {
          "dia": "2026-01-01",
          "horaInicio": "09:00",
          "horaFin": "17:00",
          "calendarioNombre": "Calendario 2026"
        }
      ]
    }
}