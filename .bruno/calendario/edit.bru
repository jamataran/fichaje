meta {
    name: Edit Calendario
    type: http
    seq: 3
}

put {
    url: {{baseUrl}}/calendario/:id
    body: json
    auth: inherit
}

params:path {
    id: 5
}

body:json {
    {
      "id": 5,
      "nombre": "Calendario 2026",
