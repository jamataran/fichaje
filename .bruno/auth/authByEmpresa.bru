meta {
    name: Auth By Empresa
    type: http
    seq: 3
}

post {
    url: {{baseUrl}}/auth/empresa
    body: json
    auth: inherit
}

body:json {
    {
        "empresaId": {{empresaId}}
    }
}

script:post-response {
  const data = res.getBody();
  if (data && data.token) {
    bru.setEnvVar("token", data.token);
  }
  // Al regenerar el token para una empresa, guardamos ese ID como el actual
  bru.setEnvVar("empresaId", req.getBody().empresaId);
}
