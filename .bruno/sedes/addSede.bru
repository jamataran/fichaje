meta {
    name: Add Sede
    type: http
    seq: 2
}

post {
    url: {{baseUrl}}/sedes/empresa/:empresaId
    body: json
    auth: inherit
}

params:path {
    empresaId: 1
}

body:json {
    {
        "nombre": "Sede Central Madrid",
        "direccion": "Calle Principal 123",
        "codigoPostal": "28001",
        "localidad": "Madrid",
        "provincia": "Madrid",
        "pais": "España",
        "activa": true,
        "ubicacion": {
            "type": "Point",
            "coordinates": [40.4168, -3.7038]
        }
    }
}

